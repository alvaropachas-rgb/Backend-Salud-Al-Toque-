    {
      "name": "11 - Events & Async Integration Test",
      "description": "Flujo funcional completo para probar eventos + asincronia: paciente crea cita -> profesional inicia sesión y acepta -> profesional completa -> paciente inicia sesión y crea review. Los listeners @Async deben ejecutarse en notification-*.",
      "item": [
        {
          "name": "00 - Backend reachable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/",
            "description": "Comprueba que baseUrl responde. Un 404 no necesariamente significa que Spring esté caído."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is successful', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "pm.test('Response time captured', function () { pm.expect(pm.response.responseTime).to.be.a('number'); });",
                  "console.log('HTTP', pm.request.method, pm.request.url.toString(), 'status=', pm.response.code, 'responseTimeMs=', pm.response.responseTime);",
                  "console.log('Si este endpoint devuelve 404 pero hay respuesta, confirma que el servidor escucha en baseUrl; ajusta el path si tu app no expone /.');"
                ]
              }
            }
          ]
        },
        {
          "name": "01 - UserRegisteredEvent - Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signup",
            "description": "Dispara UserRegisteredEvent. Revisa el backend para comprobar que el listener corre en notification-*.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Async Test Patient\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"phone\": \"999999999\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', 'async.' + Date.now() + '@example.com');",
                  "console.log('TEST EMAIL =', pm.collectionVariables.get('testEmail'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is successful', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "pm.test('Response time captured', function () { pm.expect(pm.response.responseTime).to.be.a('number'); });",
                  "console.log('HTTP', pm.request.method, pm.request.url.toString(), 'status=', pm.response.code, 'responseTimeMs=', pm.response.responseTime);",
                  "let data = {}; try { data = pm.response.json(); } catch(e) {}",
                  "if (data.token) pm.collectionVariables.set('token', data.token);",
                  "if (data.accessToken) pm.collectionVariables.set('token', data.accessToken);",
                  "console.log('EXPECTED EVENT: UserRegisteredEvent -> listener should run on notification-* thread.');"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Patient - Sign In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signin",
