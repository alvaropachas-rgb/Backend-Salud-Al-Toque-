          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let data = {}; try { data = pm.response.json(); } catch(e) {}",
                  "if (data.token) pm.collectionVariables.set('adminToken', data.token);",
                  "if (data.accessToken) pm.collectionVariables.set('adminToken', data.accessToken);",
                  "pm.test('Admin JWT stored', function () { pm.expect(pm.collectionVariables.get('adminToken')).to.not.be.empty; });"
                ]
              }
            }
          ]
        }
