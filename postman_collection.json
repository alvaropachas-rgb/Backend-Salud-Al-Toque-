          }
        },
        {
          "name": "My Professional Appointments (PROFESSIONAL)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{professionalToken}}"
              }
            ],
            "url": "{{baseUrl}}/appointments/my-professional-appointments",
            "description": "Requiere rol PROFESSIONAL. Lista las citas asignadas al profesional autenticado."
          }
        },
        {
          "name": "Create Appointment (PATIENT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/appointments",
            "description": "Requiere rol PATIENT. Valida formato YYYY-MM-DD / HH:mm, disponibilidad del profesional (día en español) y que el horario no esté reservado. El profesional se obtiene del medicalServiceId. Estado inicial: PENDIENTE. Dispara AppointmentCreatedEvent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-10-05\",\n  \"time\": \"10:30\",\n  \"notes\": \"Consulta de control\",\n  \"medicalServiceId\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is created or successful', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "let data = {}; try { data = pm.response.json(); } catch(e) {}",
                  "if (data.id) pm.collectionVariables.set('eventTestAppointmentId', String(data.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "Accept Appointment (PROFESSIONAL)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{professionalToken}}"
              }
            ],
            "url": "{{baseUrl}}/appointments/{{eventTestAppointmentId}}/accept",
            "description": "Solo citas PENDIENTE -> ACEPTADA. 409 si ya no está pendiente; 403 si la cita es de otro profesional."
          }
        },
        {
          "name": "Reject Appointment (PROFESSIONAL)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{professionalToken}}"
              }
            ],
            "url": "{{baseUrl}}/appointments/{{eventTestAppointmentId}}/reject",
            "description": "Solo citas PENDIENTE -> RECHAZADA. 409 si ya no está pendiente; 403 si la cita es de otro profesional."
          }
        },
        {
          "name": "Complete Appointment (PROFESSIONAL)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{professionalToken}}"
              }
            ],
            "url": "{{baseUrl}}/appointments/{{eventTestAppointmentId}}/complete",
            "description": "Solo citas ACEPTADA -> COMPLETADA. Requerido antes de que el paciente pueda dejar una review. 409 si no está aceptada."
          }
        },
        {
          "name": "Delete Appointment (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/appointments/{{eventTestAppointmentId}}",
            "description": "Requiere rol ADMIN. 404 si la cita no existe."
          }
        }
      ]
    },
