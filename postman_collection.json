    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signup",
            "description": "Registra un nuevo usuario (paciente). Dispara UserRegisteredEvent -> listener async en notification-*.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nuevo Paciente\",\n  \"email\": \"paciente.{{$timestamp}}@example.com\",\n  \"password\": \"Paciente123\",\n  \"phone\": \"999999999\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is successful', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "let data = {}; try { data = pm.response.json(); } catch(e) {}",
                  "if (data.token) pm.collectionVariables.set('token', data.token);",
                  "if (data.accessToken) pm.collectionVariables.set('token', data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signin",
            "description": "Login genérico. El token se guarda en la variable {{token}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"luis@gmail.com\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) pm.collectionVariables.set('token', data.token);",
                  "if (data.accessToken) pm.collectionVariables.set('token', data.accessToken);",
                  "pm.test('JWT token was stored', function () { pm.expect(pm.collectionVariables.get('token')).to.not.be.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign In - Professional",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/signin",
            "description": "Login del profesional. Guarda el token en {{professionalToken}}; usado en endpoints PROFESSIONAL (medical-services, availabilities, accept/reject/complete).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{professionalEmail}}\",\n  \"password\": \"{{professionalPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let data = {}; try { data = pm.response.json(); } catch(e) {}",
                  "if (data.token) pm.collectionVariables.set('professionalToken', data.token);",
                  "if (data.accessToken) pm.collectionVariables.set('professionalToken', data.accessToken);",
                  "pm.test('Professional JWT stored', function () { pm.expect(pm.collectionVariables.get('professionalToken')).to.not.be.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign In - Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
